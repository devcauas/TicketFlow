# Copie para .env e preencha. O .env nunca entra no Git.

# PostgreSQL (tickets, classificações e correções; também guarda o backend do MLflow)
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=ticketflow
POSTGRES_PORT=5432

# MLflow
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000

# LLM via API (provedor ainda em aberto, ver Pendências no README)
LLM_API_KEY=
